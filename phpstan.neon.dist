parameters:
    level: 6
    checkMissingIterableValueType: false
    checkGenericClassInNonGenericObjectType: false
    paths:
        - src
    scanDirectories:
        - src
        - NGEssentials/src
        - WorldStyler/src
        - phar://PharBuilder/PocketMine-MP.phar
    excludePaths:
        analyse:
            - src/MyPlot/provider